{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "apps/admin",
      "framework": "vite"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin/assets/(.*)",
      "destination": {
        "service": "admin",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/admin(.*)",
      "destination": {
        "service": "admin",
        "path": "/index.html"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/vite.svg",
      "destination": {
        "service": "web",
        "path": "/vite.svg"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/index.html"
      }
    }
  ]
}
